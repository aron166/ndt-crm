generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// MULTI-TENANCY
// ─────────────────────────────────────────────

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  companies              Company[]
  persons                Person[]
  users                  User[]
  contacts               Contact[]
  leads                  Lead[]
  deals                  Deal[]
  proposals              Proposal[]
  invoices               Invoice[]
  tasks                  Task[]
  interactions           Interaction[]
  equipment              Equipment[]
  etlRuns                EtlRun[]
  tags                   Tag[]
  auditLogs              AuditLog[]
  pipelines              Pipeline[]
  conversations          Conversation[]
  appEvents              AppEvent[]
  savedViews             SavedView[]
  integrationCredentials IntegrationCredential[]
  enrichmentRuns         EnrichmentRun[]
  enrichmentProposals    EnrichmentProposal[]
  appApiKeys             AppApiKey[]
  leadStatuses           LeadStatus[]
  automationRules        AutomationRule[]
  automationFirings      AutomationFiring[]
  campaigns              Campaign[]
  contentItems           ContentItem[]
  contentAssets          ContentAsset[]

  @@map("tenants")
}

model SavedView {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  name       String
  entityType String   @map("entity_type") // company | person | deal | task
  filters    Json                          // URL param bundle: { search, pipeline_status, ... }
  isShared   Boolean  @default(true) @map("is_shared")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType])
  @@map("saved_views")
}

// ─────────────────────────────────────────────
// CORE ENTITIES
// ─────────────────────────────────────────────

// Person = a human being. Persists across employers.
// Do NOT collapse this into Contact.
model Person {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  phone       String?
  linkedinUrl String?  @map("linkedin_url")
  notes       String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  contacts      Contact[]      // all company relationships this person has had
  interactions  Interaction[]
  tasks         Task[]         @relation("TaskPerson")
  deals         Deal[]         @relation("DealPerson")
  conversations Conversation[]
  appEvents     AppEvent[]

  @@map("persons")
}

// Company = an organization. Deduplicated on vat_number.
model Company {
  id                   Int       @id @default(autoincrement())
  tenantId             Int       @map("tenant_id")
  name                 String
  vatNumber            String?   @map("vat_number")   // 8-digit Hungarian VAT, stripped of branch suffix
  shortCode            String?   @map("short_code")   // internal code e.g. "ACH", "AGR"
  status               String?                        // active, inactive, F.A.
  accountType          String?   @map("account_type") // Customer, Lead, Vendor
  industryCode         String?   @map("industry_code") // TEÁOR sector A-U
  country              String?
  county               String?
  city                 String?
  address              String?
  zipCode              String?   @map("zip_code")
  website              String?
  notes                String?                        // free-text intel (e.g. BirdsView target research blocks)
  pipelineStatus       String?   @map("pipeline_status") // 0-8 status codes
  lastInteractionDate  DateTime? @map("last_interaction_date")
  lastInteractionOwner String?   @map("last_interaction_owner")
  lat                  Float?
  lng                  Float?
  geocodedAt           DateTime? @map("geocoded_at")
  // ── Enriched contact / classification ───────────────────────────────────
  euVatNumber          String?   @map("eu_vat_number")
  linkedinUrl          String?   @map("linkedin_url")
  leadSource           String?   @map("lead_source")
  warmth               String?   // cold | warm | hot
  // ── TEÁOR / industry ────────────────────────────────────────────────────
  teaorCode            String?   @map("teaor_code")         // 4-digit e.g. "2511"
  teaorDescription     String?   @map("teaor_description")  // "Fémszerkezet gyártása"
  industryEn           String?   @map("industry_en")
  scopeOfActivity      String?   @map("scope_of_activity")
  // ── NDT capability matrix ────────────────────────────────────────────────
  ndtMethods           String[]  @map("ndt_methods")        // ["VT","PT","MT","UT","RT","DRT","LT","HT","SPECTRO"]
  productAreas         String[]  @map("product_areas")      // ["w","wp","f","c","t","p"]
  materials            String[]                             // ["Fe","Al","Cu","AM"]
  products             String[]                             // GYÁRTMÁNY_01-07
  isPedCompliant       Boolean?  @map("is_ped_compliant")
  inspectionFrequency  String?   @map("inspection_frequency")
  hasInternalLab       Boolean?  @map("has_internal_lab")
  competitor1          String?   @map("competitor_1")
  competitor2          String?   @map("competitor_2")
  competitor3          String?   @map("competitor_3")
  // ── Operating address (telephely) ───────────────────────────────────────
  siteZip              String?   @map("site_zip")
  siteCity             String?   @map("site_city")
  siteStreet           String?   @map("site_street")
  siteCounty           String?   @map("site_county")
  siteCountry          String?   @map("site_country")
  // ── Revenue summary ─────────────────────────────────────────────────────
  revenue2019          BigInt?   @map("revenue_2019")
  revenue2020          BigInt?   @map("revenue_2020")
  revenue2021          BigInt?   @map("revenue_2021")
  revenue2022          BigInt?   @map("revenue_2022")
  revenue2023          BigInt?   @map("revenue_2023")
  revenue2024          BigInt?   @map("revenue_2024")
  customerValue        BigInt?   @map("customer_value")
  customFields         Json?     @map("custom_fields")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  contacts      Contact[]
  leads         Lead[]
  deals         Deal[]
  proposals     Proposal[]
  invoices      Invoice[]
  interactions  Interaction[]
  tasks         Task[]         @relation("TaskCompany")
  conversations Conversation[]
  appEvents     AppEvent[]

  @@unique([tenantId, vatNumber])
  @@map("companies")
}

// Contact = person at company, time-bound state.
// This is NOT the entity — Person is the entity.
// ended_at = null means currently works here.
model Contact {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  personId  Int       @map("person_id")
  companyId Int       @map("company_id")
  role      String?
  email     String?   // work email, may differ from person.email
  phone     String?   // work phone
  isPrimary Boolean   @default(false) @map("is_primary")
  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  person  Person  @relation(fields: [personId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  leads   Lead[]

  @@map("contacts")
}

// User = Controllabor employee using the system
model User {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("member") // admin, manager, member
  createdAt    DateTime @default(now()) @map("created_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  assignedTasks    Task[]        @relation("TaskAssignee")
  loggedInteractions Interaction[]
  assignedLeads    Lead[]        @relation("LeadAssignee")
  assignedDeals    Deal[]        @relation("DealAssignee")

  @@map("users")
}

// ─────────────────────────────────────────────
// PIPELINE
// ─────────────────────────────────────────────

model Lead {
  id              Int       @id @default(autoincrement())
  tenantId        Int       @map("tenant_id")
  companyId       Int?      @map("company_id")
  contactId       Int?      @map("contact_id")
  assignedToId    Int?      @map("assigned_to_id")
  source          String?                          // Web, phone, email, referral
  sourceApp       String?   @map("source_app")      // app slug from the API key that submitted it (betonscan_landing, n8n, ...)
  status          String?                          // new, contacted, replied, call_booked, qualified, proposal_sent, unqualified, nurture
  subject         String?
  message         String?                          // free-text body from the landing-page / intake form
  serviceInterest String?   @map("service_interest")
  estimatedValue  Decimal?  @map("estimated_value")
  receivedDate    DateTime? @map("received_date")
  lostReason      String?   @map("lost_reason")
  rawSourceFile   String?   @map("raw_source_file")
  customFields    Json?     @map("custom_fields")   // marketing passthrough: utm_*, referrer, landing_variant, lead_score, priority, contact snapshot
  // Lead→deal hand-off: once set, the lead has graduated to the deal pipeline and
  // leaves the active leads board (kept for origin/history, never duplicated).
  // See memory lead-deal-process-tracker-model.
  convertedDealId Int?      @map("converted_deal_id")
  convertedAt     DateTime? @map("converted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  company       Company? @relation(fields: [companyId], references: [id])
  contact       Contact? @relation(fields: [contactId], references: [id])
  assignedTo    User?    @relation("LeadAssignee", fields: [assignedToId], references: [id])
  convertedDeal Deal?    @relation("LeadConvertedDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)

  @@index([tenantId, convertedDealId])
  @@map("leads")
}

// Customizable columns of the LEAD pipeline (the cold/inbound qualification
// funnel), the counterpart to PipelineStage for deals. Lead.status references
// LeadStatus.key (stable slug; the label is the editable display name).
model LeadStatus {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  key        String                                       // stable slug stored on Lead.status
  label      String
  color      String   @default("#6366f1")
  position   Int      @default(0)
  isInitial  Boolean  @default(false) @map("is_initial")  // where inbound API leads land
  isTerminal Boolean  @default(false) @map("is_terminal") // terminal-lost style (greyed)
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("lead_statuses")
}

// ─────────────────────────────────────────────
// PIPELINES
// ─────────────────────────────────────────────

model Pipeline {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  name        String
  description String?
  isArchived  Boolean  @default(false) @map("is_archived")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  stages       PipelineStage[]
  deals        Deal[]
  customFields PipelineCustomField[]

  @@map("pipelines")
}

model PipelineStage {
  id            Int     @id @default(autoincrement())
  pipelineId    Int     @map("pipeline_id")
  name          String
  color         String  @default("#6366f1")
  probability   Int     @default(50)           // 0–100 — used for weighted forecast
  position      Int     @default(0)
  isTerminalWon  Boolean @default(false) @map("is_terminal_won")
  isTerminalLost Boolean @default(false) @map("is_terminal_lost")
  wipLimit      Int?    @map("wip_limit")
  createdAt     DateTime @default(now()) @map("created_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@map("pipeline_stages")
}

model PipelineCustomField {
  id         Int     @id @default(autoincrement())
  pipelineId Int     @map("pipeline_id")
  key        String
  label      String
  type       String  // text | number | date | single_select | multi_select | person | company
  required   Boolean @default(false)
  position   Int     @default(0)
  options    Json?   // for select types: ["Option A", "Option B"]

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@unique([pipelineId, key])
  @@map("pipeline_custom_fields")
}

model Deal {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @map("tenant_id")
  pipelineId        Int?      @map("pipeline_id")
  stageId           Int?      @map("stage_id")
  companyId         Int       @map("company_id")
  personId          Int?      @map("person_id")     // primary contact
  assignedToId      Int?      @map("assigned_to_id")
  title             String
  value             Decimal?
  currency          String    @default("HUF")
  expectedCloseDate DateTime? @map("expected_close_date")
  lostReason        String?   @map("lost_reason")
  position          Int       @default(0)            // order within stage
  customFields      Json?     @map("custom_fields")  // JSONB values keyed by PipelineCustomField.key
  stageEnteredAt    DateTime? @map("stage_entered_at") // set when the deal enters its current stage; basis for deal_idle_in_stage automations
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  pipeline   Pipeline?      @relation(fields: [pipelineId], references: [id])
  stage      PipelineStage? @relation(fields: [stageId], references: [id])
  company    Company        @relation(fields: [companyId], references: [id])
  person     Person?        @relation("DealPerson", fields: [personId], references: [id])
  assignedTo User?          @relation("DealAssignee", fields: [assignedToId], references: [id])
  proposals  Proposal[]
  tasks      Task[]         @relation("TaskDeal")
  convertedFromLeads Lead[] @relation("LeadConvertedDeal")
  automationFirings  AutomationFiring[]

  @@index([pipelineId, stageId, position])
  @@map("deals")
}

// Proposal = offer document sent. Linked to a Deal.
model Proposal {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  companyId     Int       @map("company_id")
  dealId        Int?      @map("deal_id")
  result        String?   // closed_won, closed_lost, pending, proposal
  lostReason    String?   @map("lost_reason")
  campaign      String?
  sentDate      DateTime? @map("sent_date")
  receivedDate  DateTime? @map("received_date")
  invoiceNumber String?   @map("invoice_number")
  rawLabel      String?   @map("raw_label")        // original folder/file label from xlsx
  rawSourceFile String?   @map("raw_source_file")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  deal    Deal?   @relation(fields: [dealId], references: [id])

  @@map("proposals")
}

model Invoice {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  companyId      Int?      @map("company_id")
  companyName    String?   @map("company_name")    // denormalized — historical records may not link
  invoiceNumber  String?   @map("invoice_number")
  netAmount      Decimal?  @map("net_amount")
  currency       String    @default("HUF")
  completionDate DateTime? @map("completion_date")
  issuedDate     DateTime? @map("issued_date")
  dueDate        DateTime? @map("due_date")
  year           Int?
  rawSourceFile  String?   @map("raw_source_file")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@map("invoices")
}

// ─────────────────────────────────────────────
// TASKS
// The heart of the system. Everything is a task.
// Tasks are atomic — "write email" and "send email" are two tasks.
// ─────────────────────────────────────────────

model Task {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  assignedToId     Int?      @map("assigned_to_id")
  companyId        Int?      @map("company_id")
  dealId           Int?      @map("deal_id")
  personId         Int?      @map("person_id")
  parentTaskId     Int?      @map("parent_task_id")
  title            String
  description      String?
  type             String?   // call, email, meeting, document, field_visit, internal
  category         String?   // revenue_generating, non_revenue
  status           String    @default("created")     // created, in_progress, done, cancelled
  executorType     String    @default("human") @map("executor_type") // human, ai_agent, robot
  costCode         String?   @map("cost_code")        // KID, MRD, DOD, SZD, VIZSGALAT
  setMembership    String[]  @map("set_membership")   // user-defined set membership
  skillRequiredId  Int?      @map("skill_required_id") // FK added in Step 4.5
  dueDate          DateTime? @map("due_date")
  completedAt      DateTime? @map("completed_at")
  estimatedMinutes Int?      @map("estimated_minutes") // normaidő — measured against actual
  actualMinutes    Int?      @map("actual_minutes")
  isRecurring      Boolean   @default(false) @map("is_recurring")
  recurrenceRule   String?   @map("recurrence_rule")  // RRULE string e.g. "FREQ=WEEKLY;BYDAY=MO"
  notifyBefore     Int?      @map("notify_before")    // days before due date to notify
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  assignedTo User?    @relation("TaskAssignee", fields: [assignedToId], references: [id])
  company    Company? @relation("TaskCompany", fields: [companyId], references: [id])
  deal       Deal?    @relation("TaskDeal", fields: [dealId], references: [id])
  person     Person?  @relation("TaskPerson", fields: [personId], references: [id])
  parentTask Task?    @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks   Task[]   @relation("SubTasks")

  @@map("tasks")
}

// ─────────────────────────────────────────────
// INTERACTIONS
// Append-only. Never update, never delete.
// ─────────────────────────────────────────────

model Interaction {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  companyId  Int?     @map("company_id")
  personId   Int?     @map("person_id")
  userId     Int?     @map("user_id")   // who logged this
  type       String?  // call, email, meeting, note, site_visit
  direction  String?  // inbound, outbound
  notes      String?
  outcome    String?  // maps to 0-8 status codes
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  person  Person?  @relation(fields: [personId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@map("interactions")
}

// ─────────────────────────────────────────────
// EQUIPMENT
// NDT instruments — serial numbers auto-populate reports
// ─────────────────────────────────────────────

model Equipment {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  name           String
  serialNumber   String?   @map("serial_number")
  model          String?
  manufacturer   String?
  calibrationDue DateTime? @map("calibration_due")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("equipment")
}

// ─────────────────────────────────────────────
// ETL AUDIT
// ─────────────────────────────────────────────

model EtlRun {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @map("tenant_id")
  filename           String
  status             String    // running, success, error
  companiesLoaded    Int?      @map("companies_loaded")
  invoicesLoaded     Int?      @map("invoices_loaded")
  leadsLoaded        Int?      @map("leads_loaded")
  proposalsLoaded    Int?      @map("proposals_loaded")
  interactionsLoaded Int?      @map("interactions_loaded")
  errorMessage       String?   @map("error_message")
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("etl_runs")
}

// ─────────────────────────────────────────────
// TAGS
// Cross-entity tagging — company / person / deal / task / interaction
// ─────────────────────────────────────────────

model Tag {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String
  color     String   @default("#6366f1") // hex color
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  taggings Tagging[]

  @@unique([tenantId, name])
  @@map("tags")
}

model Tagging {
  id            Int      @id @default(autoincrement())
  tagId         Int      @map("tag_id")
  taggableType  String   @map("taggable_type") // company | person | deal | task | interaction
  taggableId    Int      @map("taggable_id")
  createdAt     DateTime @default(now()) @map("created_at")

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, taggableType, taggableId])
  @@index([taggableType, taggableId])
  @@map("taggings")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// Append-only. Every create/update/delete on business entities.
// actor_user_id = Supabase Auth UUID (nullable for system/agent actions)
// ─────────────────────────────────────────────

model AuditLog {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  actorUserId  String?  @map("actor_user_id")  // Supabase Auth UUID
  actorAgentId String?  @map("actor_agent_id") // Step 5: agent identity
  action       String   // create | update | delete
  entityType   String   @map("entity_type")
  entityId     Int      @map("entity_id")
  changes      Json     // { before: {...} | null, after: {...} | null }
  occurredAt   DateTime @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([entityType, entityId])
  @@index([tenantId, occurredAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────
// ECOSYSTEM HUB
// Central ledger for the whole Uphill Trade portfolio.
// VeloQuote, BirdsView, CashFlow, and the agent team
// write into these tables via the ingestion API.
// ─────────────────────────────────────────────

model Agent {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // sales_assistant, intake_bot, mira_cmo, nate_dev
  owner     String?  // veloQuote, birdsview, cashflow, ndt-crm
  createdAt DateTime @default(now()) @map("created_at")

  conversations Conversation[]
  appEvents     AppEvent[]

  @@map("agents")
}

model Conversation {
  id        Int       @id @default(autoincrement())
  tenantId  Int       @map("tenant_id")
  agentId   Int?      @map("agent_id")
  personId  Int?      @map("person_id")
  companyId Int?      @map("company_id")
  channel   String    // web_chat, phone, email, intake_form
  summary   String?
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])
  person   Person?   @relation(fields: [personId], references: [id])
  company  Company?  @relation(fields: [companyId], references: [id])
  messages Message[]

  @@index([tenantId, personId])
  @@index([tenantId, companyId])
  @@map("conversations")
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  role           String   // user, assistant, system
  content        String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

// ─────────────────────────────────────────────
// INTEGRATIONS
// ─────────────────────────────────────────────

model IntegrationCredential {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @map("tenant_id")
  integrationSlug String   @map("integration_slug") // google_maps | google_calendar | resend | twilio
  credentials     Json                               // { apiKey, ... } — encrypt at rest in Step 6 full build
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, integrationSlug])
  @@map("integration_credentials")
}

// Per-app ingestion credentials (Platform Foundation #4).
// Scoped, hashed, revocable API keys issued per source app (betonscan_landing,
// n8n, ...). The public /api/leads route authenticates with these — never the
// shared Supabase service-role key. Only the SHA-256 hash is stored; the
// plaintext key is shown to the operator exactly once, at creation.
model AppApiKey {
  id         Int       @id @default(autoincrement())
  tenantId   Int       @map("tenant_id")
  appSlug    String    @map("app_slug")   // betonscan_landing | n8n | birdsview | ...
  keyHash    String    @unique @map("key_hash") // SHA-256 hex of the plaintext key
  label      String?                            // optional human label
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("app_api_keys")
}

model AppEvent {
  id         Int      @id @default(autoincrement())
  tenantId   Int      @map("tenant_id")
  agentId    Int?     @map("agent_id")
  personId   Int?     @map("person_id")
  companyId  Int?     @map("company_id")
  sourceApp  String   @map("source_app")  // veloQuote, birdsview, cashflow
  eventType  String   @map("event_type")  // quote.created, lead.submitted, proposal.sent
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  agent   Agent?   @relation(fields: [agentId], references: [id])
  person  Person?  @relation(fields: [personId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([tenantId, sourceApp])
  @@index([tenantId, eventType])
  @@index([tenantId, companyId])
  @@index([tenantId, personId])
  @@map("app_events")
}

// Configurable task-automation rules: "when <trigger> [and <conditions>] →
// <action>". v1 action = create a task. The event-driven triggers fire from
// domain mutations (lead intake, lead status change, deal stage change); the
// time-based trigger (deal_idle_in_stage) is evaluated by a scheduled job.
// Generalises the hard-coded new-lead follow-up task into user-editable rules.
model AutomationRule {
  id            Int       @id @default(autoincrement())
  tenantId      Int       @map("tenant_id")
  name          String
  isActive      Boolean   @default(true) @map("is_active")
  triggerType   String    @map("trigger_type")   // lead_created | lead_status_changed | deal_stage_changed | deal_idle_in_stage
  triggerConfig Json?     @map("trigger_config")  // { toStatus?, toStageId?, stageId?, idleDays? }
  conditions    Json?                             // [{ field, op, value }] AND-ed; empty/null = always
  actionType    String    @map("action_type")     // create_task
  actionConfig  Json      @map("action_config")    // { titleTemplate, type, category, dueInDays, descriptionTemplate, assignedToId? }
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  firings AutomationFiring[]

  @@index([tenantId, triggerType, isActive])
  @@map("automation_rules")
}

// Dedupe ledger for time-based automations (deal_idle_in_stage). One row per
// (rule, deal, stage-entry) — the unique constraint guarantees a given idle
// rule fires at most once per stage entry, even across overlapping cron runs.
// When a deal moves to a new stage its stageEnteredAt changes, so the rule can
// legitimately fire again once it goes idle in the new stage.
model AutomationFiring {
  id             Int      @id @default(autoincrement())
  tenantId       Int      @map("tenant_id")
  ruleId         Int      @map("rule_id")
  dealId         Int      @map("deal_id")
  stageEnteredAt DateTime @map("stage_entered_at")
  firedAt        DateTime @default(now()) @map("fired_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  deal   Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([ruleId, dealId, stageEnteredAt])
  @@index([tenantId])
  @@map("automation_firings")
}

// ─────────────────────────────────────────────
// ENRICHMENT ENGINE
// LLM-assisted company/person data enrichment with human review.
// ─────────────────────────────────────────────

model EnrichmentRun {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  entityType  String    @map("entity_type")  // "company" | "person"
  entityIds   Int[]     @map("entity_ids")   // which IDs were queued
  status      String    @default("pending")  // pending | running | done | failed
  triggeredBy String?   @map("triggered_by") // user email
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  proposals EnrichmentProposal[]
  tenant    Tenant @relation(fields: [tenantId], references: [id])

  @@map("enrichment_runs")
}

model EnrichmentProposal {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  runId         Int      @map("run_id")
  entityType    String   @map("entity_type")   // "company" | "person"
  entityId      Int      @map("entity_id")
  entityName    String   @map("entity_name")   // denormalized for display
  changes       Json     // { fieldName: { current, proposed, source, confidence, status } }
  overallStatus String   @default("pending") @map("overall_status") // pending | partial | approved | rejected
  rawResponse   String?  @map("raw_response")  // full LLM response for debugging
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  run    EnrichmentRun @relation(fields: [runId], references: [id])
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@map("enrichment_proposals")
}

// ─────────────────────────────────────────────
// Marketing module — the CRM as approval queue + control tower for AI-generated
// content. External jobs POST drafts via /api/content; humans review/approve in
// the CRM (often from a phone); approval can fire a webhook. Enums are app-level
// strings (codebase convention — no Prisma enums), validated by Zod / the UI.

model Campaign {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  name        String
  slug        String                                  // stable handle; auto-created on first content POST
  project     String?                                 // e.g. "birdsview"
  description String?
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  contentItems ContentItem[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("campaigns")
}

model ContentItem {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  campaignId  Int?      @map("campaign_id")
  channel     String                                  // linkedin_personal | linkedin_company | facebook | blog | email | other
  contentType String    @map("content_type")          // post | article | email | video_script | other
  title       String
  body        String                                  // markdown
  status      String    @default("draft")             // draft | in_review | approved | scheduled | published | rejected
  // INTERNAL angles (BVQ) are never postable — the publish flow is hidden for them.
  internal    Boolean   @default(false)
  scheduledFor DateTime? @map("scheduled_for")
  publishedAt DateTime?  @map("published_at")
  externalUrl String?    @map("external_url")
  source      String                                  // content_factory | manual | <app slug>
  sourceMeta  Json?      @map("source_meta")          // hook refs, week, generator notes
  metrics     Json?                                   // impressions, reactions, comments, clicks, leads (manual)
  reviewNote  String?    @map("review_note")          // rejection reason / edit note
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  campaign Campaign?      @relation(fields: [campaignId], references: [id])
  assets   ContentAsset[]

  @@index([tenantId, status])
  @@index([tenantId, campaignId])
  @@map("content_items")
}

model ContentAsset {
  id            Int      @id @default(autoincrement())
  tenantId      Int      @map("tenant_id")
  contentItemId Int      @map("content_item_id")
  kind          String                                // image | video | file | link
  url           String                                // URL or storage path (no upload UI this phase)
  caption       String?
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contentItemId])
  @@map("content_assets")
}
