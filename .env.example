# Database
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=ndt_crm
DATABASE_URL=postgresql://crm:crm@localhost:5434/ndt_crm

# Auth
JWT_SECRET=change_this_in_production

# AI
GROQ_API_KEY=your_groq_api_key_here

# App
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Campaign mailbox route (web/, 2026-11-18): prospect campaigns sent through a Google Workspace mailbox over SMTP.
# Off unless HOST, USER and PASS are all set. PASS is a Google app password (2-Step Verification on), never the login password.
CAMPAIGN_SMTP_HOST=
CAMPAIGN_SMTP_PORT=
CAMPAIGN_SMTP_USER=
CAMPAIGN_SMTP_PASS=
# Mails a day from the mailbox, every campaign together; default 30 (first two weeks), raise by hand after.
CAMPAIGN_SMTP_DAILY_CAP=
